/* TUI Manager — hoja de estilos (Alfa 3)
   Jerarquía: cabecera, título de pantalla, contenido, barra de estado, pie. */

Screen {
    background: $background;
}

Header {
    background: $primary;
    color: $background;
    text-style: bold;
}

Footer {
    background: $panel;
}

.title {
    padding: 1 2 0 2;
    text-style: bold;
    color: $primary;
}

.subtitle {
    padding: 0 2;
    color: $text-muted;
}

.status {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

/* Listas y tablas: borde redondeado, margen lateral y foco visible. */

ListView {
    border: round $primary;
    margin: 1 2;
    height: 1fr;
}

ListView:focus {
    border: round $accent;
}

ListItem {
    padding: 0 1;
}

ListItem.disabled {
    color: $text-disabled;
}

DataTable {
    border: round $primary;
    margin: 1 2 0 2;
    height: 1fr;
}

DataTable:focus {
    border: round $accent;
}

DataTable > .datatable--header {
    background: $panel;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $background;
}

Input {
    border: tall $secondary;
    margin: 1 2 0 2;
}

Input:focus {
    border: tall $accent;
}

Select {
    border: tall $secondary;
    margin: 1 2 0 2;
}

Select:focus {
    border: tall $accent;
}

VerticalScroll {
    padding: 0 1;
}

/* Modales centrados sobre fondo atenuado. */

ConfirmScreen,
InputScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.dialog Label {
    padding: 0 0 1 0;
}

.dialog Input {
    margin: 0;
}

.dialog Footer {
    background: $surface;
}

/* Variantes semánticas para mensajes. */

.success {
    color: $success;
}

.warning {
    color: $warning;
}

.error {
    color: $error;
}
