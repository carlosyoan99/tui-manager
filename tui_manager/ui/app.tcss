/* TUI Manager — hoja de estilos (Alfa 3)
   Jerarquía: cabecera, título de pantalla, contenido, barra de estado, pie. */

Screen {
    background: $background;
}

Header {
    background: $primary;
    color: $background;
    text-style: bold;
}

Footer {
    background: $panel;
}

.title {
    padding: 1 2 0 2;
    text-style: bold;
    color: $primary;
}

.subtitle {
    padding: 0 2;
    color: $text-muted;
}

/* Jerarquía visual única: todo título usa `.title` y todo estado (incluidos
   los estados vacíos y los modales) usa `.status`. Sin variantes por pantalla. */
.status {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

/* Listas y tablas: borde redondeado, margen lateral y foco visible. */

ListView {
    border: round $primary;
    margin: 1 2;
    height: 1fr;
}

ListView:focus {
    border: round $accent;
}

ListItem {
    padding: 0 1;
}

ListItem.disabled {
    color: $text-disabled;
}

DataTable {
    border: round $primary;
    margin: 1 2 0 2;
    height: 1fr;
}

DataTable:focus {
    border: round $accent;
}

DataTable > .datatable--header {
    background: $panel;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $background;
}

Input {
    border: tall $secondary;
    margin: 1 2 0 2;
}

Input:focus {
    border: tall $accent;
}

Select {
    border: tall $secondary;
    margin: 1 2 0 2;
}

Select:focus {
    border: tall $accent;
}

/* Ajustes: los Select tienen ancho fijo y no se reparten el disponible
   lado a lado; la etiqueta queda siempre legible a su izquierda. */
Select.select-compact {
    width: 34;
    max-width: 60%;
}

/* 2.0-A2: barra de estado con ayuda clicable. El botón «?» comparte fila
   con el estado y no se estira; el texto sigue legible a la izquierda. */
.status-bar {
    height: 3;
    align: left middle;
}

.status-bar .status {
    height: 3;
    width: 1fr;
    content-align: left middle;
}

/* 2.0-A1/A2: botones compactos de modales y ayudas (nunca a todo lo ancho). */
.button-compact {
    width: auto;
    min-width: 12;
    max-width: 22;
}

.button-compact.help-button {
    width: 6;
    min-width: 6;
    max-width: 6;
}

.button-row {
    height: 3;
    align: center middle;
}

VerticalScroll {
    padding: 0 1;
}

/* Modales centrados sobre fondo atenuado. */

ConfirmScreen,
InputScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.dialog Label {
    padding: 0 0 1 0;
}

.dialog Input {
    margin: 0;
}

.dialog Footer {
    background: $surface;
}

/* Función G: webapps ligeras. Hereda el estilo común de listas y estado. */
WebAppsScreen Input#webapps-search {
    height: 3;
}

WebAppsScreen LoadingIndicator#webapps-loading {
    height: 1;
}

/* Variantes semánticas para mensajes. */

.success {
    color: $success;
}

.warning {
    color: $warning;
}

.error {
    color: $error;
}
